cat >> .gitignore << 'EOF'

# SSL Certificates (SENSITIF!)
*.pem
*.key
*.crt
backend/nginx/ssl/

# Docker (semua file docker)
docker-compose.yml
docker-compose.*.yml
Dockerfile
*.Dockerfile
docker/
backend/Dockerfile
backend/nginx/
nginx/

# Server config
backend/nixpacks.toml
*.toml

# Binary installers
*.deb

# Testing (sesuai instruksi dosen)
backend/testing/
backend/tests/
frontend/src/__tests__/

# Build artifacts
frontend/.tsbuildinfo/
EOF